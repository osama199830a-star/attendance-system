# انسخ هذا الملف إلى .env (لا ترفع .env إلى GitHub). لا تضع كلمات مرور حقيقية داخل الكود.
ATT_MODE=cloud                 # cloud على الخادم المركزي، وفارغ على جهاز الدكتور
ADMIN_USER=admin
ADMIN_PASS=غيّرني-كلمة-مرور-قوية
SYNC_KEY=ضع-نصاً-عشوائياً-طويلاً-32+-حرفاً      # نفسه على الخادم وأجهزة الدكاترة (يوقّع دفعات البريد)
SESSION_SECRET=نص-عشوائي-آخر
COOKIE_SECURE=1                # 0 فقط عند التجربة على http داخل الشبكة
# اختياري: رمز OAuth2 بدل كلمة مرور التطبيق في IMAP/SMTP
# MAIL_OAUTH2_TOKEN=
